    - target: {fileID: 7974041695187498103, guid: 618f148dfa71db643999df3e0b548c52, type: 3}
      propertyPath: m_text
      value: "In the map interface or main menu, you can enter the character menu
        to switch adventurers.\r\n\r\nThe details of the currently selected adventurer
        will be displayed in the upper interface,\nand you can view their skills
        and abilities details by clicking on its icon.\r\n\r\nBy <color=red>double-clicking</color>
        on the adventurer\u2019s icon, you can select that character for battle.\n(Note:
        Some quests may forcibly lock the character to use.)"
      objectReference: {fileID: 0}
