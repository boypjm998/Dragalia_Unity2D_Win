      propertyPath: m_text
      value: "After completing a challenge quest,\nyou will receive crowns based
        on your performance in the battle.\r\n\r\nEach quest can award up to 3 crowns,\nand
        each crown cannot be obtained more than once.\r\n\r\nThe crowns you get can
        be used in the \u2018Abilities\u2019 menu to enhance your character\u2019s
        abilities."
      objectReference: {fileID: 0}
